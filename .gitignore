# dependencies and environments
node_modules/
.venv/
.venv-*/
**/.venv*/
__pycache__/
*.pyc

# large or generated working data
mvp/work/*
!mvp/work/schema/
spike/*/data/
spike/*/results/**/*.png
spike/classical/results/*.jsonl
spike/ocr/results/
spike/ocr/models/
spike/ocr/browser/assets/
spike/ml/assets/
spike/ml/dl/
spike/ml/out/
spike/ml/ortweb/
spike/ml/scans/
spike/*/vendor/
spike/opencv/node_modules/
# built by mvp/tools/build.js in CI, Pages and releases; agents with different working trees
# kept conflicting on it, so it is not tracked (mvp/dist/assets still is)
mvp/dist/index.html
corpus/**/_work/
corpus/**/_logs/
probe/
*.onnx
*.pt
*.pth
*.whl
*.tgz
*.zip

# challenge corpus: the scan-damage PDFs (~300 MB) are rebuilt in ~40 s with
# .venv/bin/python corpus/challenge/degradation/_tools/run.py (see corpus/challenge/README.md)
corpus/challenge/degradation/**/*.pdf
corpus/challenge/degradation/_pieces/**/*.png

# corpus items whose source encodings are licensed for testing only (regenerate locally,
# see corpus/synthetic/_tools/run_all.py); maintained by tools/push.sh
