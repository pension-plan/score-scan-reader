  "count_conventions": {
    "note-*, dot, double-dot, acc-*, ledger-*, tie": "per notehead (chord notes counted individually)",
    "chord, stem-up, stem-down, flag": "per stem (one per chord)",
    "beam": "number of level-1 beam groups",
    "clef-*": "initial clef of every staff + every clef change (system-start reprints and courtesy clefs not counted)",
    "clef-change": "clef elements after the initial clefs",
    "key-*": "initial key + every key change (system-start reprints and courtesy key signatures not counted); key-0 = no sharps/flats",
    "key-change": "key elements after measure 1; x-key-cancel = key changes that print cancellation naturals",
    "key-* / time-* / key-change per part": "counted per MusicXML <key>/<time> element, i.e. once per part: a multi-staff part (piano, organ) has one <key> for all its staves, so the printed signatures are N_staves times more numerous",
    "x-key-minor": "key statements in minor mode",
    "time-*": "time signature statements (time-common / time-cut replace time-4-4 / time-2-2 when the symbol is used)",
    "ottava-*": "octave-shift brackets (start elements); x-ottava-15mb = 15ma bassa",
    "ledger-above / ledger-below": "noteheads needing >= 1 ledger line (displayed staff position >= 6 or <= -6 half-spaces from the middle line, after clef / clef-octave-change / ottava)",
    "acc-courtesy": "accidentals with cautionary=\"yes\" (also counted under their glyph tag); x-acc-courtesy-paren = the parenthesised subset",
    "x-acc-natural-sharp / x-acc-natural-flat": "LilyPond \"extra natural\" before a single sharp/flat that follows a double sharp/flat in the same bar (natural-sharp / natural-flat)",
    "system-break / page-break": "explicit <print new-system/new-page> in the first part"
  },
